# Copy this file to .env and change the values.
DB_PASSWORD=change-me-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# true = load demo accounts and sample class data (for trying it out only)
SEED_DEMO=false
# true = allow the admin "Reset platform to demo data" button (never on a live site)
ALLOW_DEMO_RESET=false
# Set COOKIE_SECURE=true and TRUST_PROXY=true when the site is served over HTTPS behind a proxy
COOKIE_SECURE=false
TRUST_PROXY=
PORT=3000
