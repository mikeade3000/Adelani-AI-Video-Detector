# Copy to .env (never commit it) or set these in your host's dashboard.

# Required for AI reading, readable versions, AI marking and marking-guide import.
ANTHROPIC_API_KEY=

# The first super admin, created on first start when no accounts exist.
# Use a strong password (10+ characters, letters and numbers) and change it after signing in.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Where accounts and usage are stored. Must be a persistent disk/volume when hosted.
DATA_DIR=./data

PORT=8080
# "true" behind HTTPS (all real hosting). Use "false" only for http://localhost testing.
COOKIE_SECURE=true
# Optional: a different Claude model.
# CLAUDE_MODEL=claude-opus-5-5
