// Cloudflare deployment for Dlano. Deploy with: npx wrangler deploy  (needs Docker running)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dlano-kiu",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "containers": [
    {
      "class_name": "DlanoServer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DLANO", "class_name": "DlanoServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DlanoServer"] }],
  "observability": { "enabled": true }
}
